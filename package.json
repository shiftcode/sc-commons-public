{
  "name": "sc-commons-public",
  "private": true,
  "repository": "https://github.com/shiftcode/sc-commons-public",
  "license": "MIT",
  "author": "shiftcode GmbH <team@shiftcode.ch>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:ci": "lerna run build",
    "build:lint:ci": "lerna run build --scope @shiftcode/eslint-plugin-rules && lerna run build --scope @shiftcode/eslint-config-recommended",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint:ci": "lerna run lint:ci",
    "prepare": "husky",
    "publish-libs": "node packages/publish-helper/dist/publish-lib",
    "test:ci": "lerna run test:ci"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@swc/core": "^1.15.11",
    "@types/node": "^24.12.0",
    "eslint": "^9.36.0",
    "husky": "^9.0.11",
    "lerna": "^10.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.2",
    "sort-package-json": "^2.10.0",
    "tslib": "^2.3.0",
    "typescript": "^6.0.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.10.2",
    "npm": ">=11.16.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "nx@23.2.1": true,
    "@swc/core@1.15.11": true
  }
}
