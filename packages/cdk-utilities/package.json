  "dependencies": {
    "just-pascal-case": "^3.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.204.0",
    "@shiftcode/branch-utilities": "^6.0.0",
    "@shiftcode/iac-utilities": "^1.0.1",
    "@shiftcode/lambda-utilities": "^1.0.0",
    "@shiftcode/logger": "^5.0.0",
    "@shiftcode/utilities": "^5.0.0",
    "@slack/types": "^2.11.0",
    "@types/aws-lambda": "^8.10.89",
    "@types/jsurl": "^0.1.2",
    "aws-cdk-lib": "^2.3.0",
    "constructs": "^10.0.0",
    "esbuild": "^0.27.2",
    "jsurl": "^0.1.5"
  },
  "peerDependencies": {
    "@shiftcode/branch-utilities": "^6.0.0 || ^6.0.0-pr254",
    "@shiftcode/iac-utilities": "^1.0.1 || ^1.0.1-pr254",
    "aws-cdk-lib": "^2.3.0",
    "constructs": "^10.0.0",
    "tslib": "^2.3.0"
  },
  "engines": {
    "node": ">=24.10.2"
  },
  "publishConfig": {
    "directory": "dist"
  }
